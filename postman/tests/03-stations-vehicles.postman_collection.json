          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('station 1', () => pm.expect(b.stationId).to.eql(1));",
                  "pm.test('has unit counts', () => { pm.expect(b).to.have.property('droneUnitsAvailable'); pm.expect(b).to.have.property('robotUnitsAvailable'); });"
                ]
              }
            }
          ]
