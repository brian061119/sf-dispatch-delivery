{
  "info": {
    "name": "WeDelivery 03 · Stations & Vehicles",
    "description": "Public read endpoints for stations and vehicles (no login needed).\n\nHOW TO RUN: start the backend, then right-click the collection → Run collection → Run. It is self-contained (logs in by itself) and repeatable. baseUrl defaults to http://localhost:8080 (collection → Variables). Seeded accounts use password123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "hackerToken",
      "value": ""
    },
    {
      "key": "uniq",
      "value": ""
    },
    {
      "key": "newUser",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "trackingCode",
      "value": ""
    },
    {
      "key": "drones2Before",
      "value": ""
    },
    {
      "key": "quotedCost",
      "value": ""
    },
    {
      "key": "quotedMinutes",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Stations & vehicles",
      "item": [
        {
          "name": "List stations",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stations"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('at least 3 stations', () => pm.expect(pm.response.json().length).to.be.at.least(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Station 1 availability",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
