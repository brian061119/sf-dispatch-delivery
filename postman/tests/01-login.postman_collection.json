                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('generic login error message', () => pm.expect(pm.response.json().message).to.eql('Invalid username or password.'));"
                ]
              }
            }
          ]
        },
