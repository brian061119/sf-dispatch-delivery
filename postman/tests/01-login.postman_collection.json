                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('is vip_user', () => pm.expect(b.username).to.eql('vip_user'));",
                  "pm.test('no password hash', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));"
                ]
              }
            }
          ]
        },
