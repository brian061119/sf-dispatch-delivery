            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('not DELIVERED yet', () => pm.expect(pm.response.json().status).to.not.eql('DELIVERED'));"
                ]
              }
            }
