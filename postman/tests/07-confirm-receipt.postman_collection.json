                ]
              }
            }
          ]
        },
        {
          "name": "Status unchanged after rejected attempts",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
