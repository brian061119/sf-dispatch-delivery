{
  "info": {
    "name": "WeDelivery 04 · Recommendations & Quote",
    "description": "Recommendations (login required) and the public quote endpoint.\n\nHOW TO RUN: start the backend, then right-click the collection → Run collection → Run. It is self-contained (logs in by itself) and repeatable. baseUrl defaults to http://localhost:8080 (collection → Variables). Seeded accounts use password123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "hackerToken",
      "value": ""
    },
    {
      "key": "uniq",
      "value": ""
    },
    {
      "key": "newUser",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "trackingCode",
      "value": ""
    },
    {
      "key": "drones2Before",
      "value": ""
    },
    {
      "key": "quotedCost",
      "value": ""
    },
    {
      "key": "quotedMinutes",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login vip_user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"vip_user\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns a token', () => pm.expect(b.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('ownerToken', b.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recommendations & quote",
      "item": [
        {
          "name": "Get recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"line1\": \"Market St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94103\",\n    \"lat\": 37.7858,\n    \"lng\": -122.4065\n  },\n  \"dropoff\": {\n    \"line1\": \"Mission St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94110\",\n    \"lat\": 37.7596,\n    \"lng\": -122.4269\n  },\n  \"package\": {\n    \"description\": \"Documents\",\n    \"weightKg\": 1.5,\n    \"lengthCm\": 30,\n    \"widthCm\": 20,\n    \"heightCm\": 10,\n    \"fragile\": false\n  },\n  \"priority\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has candidates', () => pm.expect(pm.response.json().candidates).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Recommendations without login → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"line1\": \"Market St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94103\",\n    \"lat\": 37.7858,\n    \"lng\": -122.4065\n  },\n  \"dropoff\": {\n    \"line1\": \"Mission St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94110\",\n    \"lat\": 37.7596,\n    \"lng\": -122.4269\n  },\n  \"package\": {\n    \"description\": \"Documents\",\n    \"weightKg\": 1.5,\n    \"lengthCm\": 30,\n    \"widthCm\": 20,\n    \"heightCm\": 10,\n    \"fragile\": false\n  },\n  \"priority\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Quote (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/dispatch/quote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dispatch",
                "quote"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": \"Market St, San Francisco\",\n  \"pickupLat\": 37.7858,\n  \"pickupLng\": -122.4065,\n  \"dropoffAddress\": \"Mission St, San Francisco\",\n  \"dropoffLat\": 37.7596,\n  \"dropoffLng\": -122.4269,\n  \"isStationPickup\": false,\n  \"packageWeight\": 1.5,\n  \"packageVolume\": 0.02\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}