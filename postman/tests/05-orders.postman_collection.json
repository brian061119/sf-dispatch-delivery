    {
      "name": "Orders",
      "item": [
        {
          "name": "Recommendation for this trip (save the quoted price)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/recommendations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recommendations"
              ]
            },
            "description": "The next request orders this exact plan; its price must match.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"line1\": \"Market St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94103\",\n    \"lat\": 37.7858,\n    \"lng\": -122.4065\n  },\n  \"dropoff\": {\n    \"line1\": \"Mission St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94110\",\n    \"lat\": 37.7596,\n    \"lng\": -122.4269\n  },\n  \"package\": {\n    \"description\": \"Documents\",\n    \"weightKg\": 1.5,\n    \"lengthCm\": 30,\n    \"widthCm\": 20,\n    \"heightCm\": 10,\n    \"fragile\": false\n  },\n  \"priority\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json().candidates.find(x => x.candidateId === 'CAND-BEST_VALUE');",
                  "pm.test('best-value plan offered', () => pm.expect(c).to.exist);",
                  "pm.collectionVariables.set('quotedCost', c.estimatedCost);",
                  "pm.collectionVariables.set('quotedMinutes', c.estimatedTimeMinutes);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "If this returns 409, station 1 has no idle robot: run 09-dispatch-writes (simulate tick) or restart the local app.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidateId\": \"CAND-BEST_VALUE\",\n  \"pickup\": {\n    \"line1\": \"Market St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94103\",\n    \"lat\": 37.7858,\n    \"lng\": -122.4065\n  },\n  \"dropoff\": {\n    \"line1\": \"Mission St, San Francisco\",\n    \"city\": \"San Francisco\",\n    \"zip\": \"94110\",\n    \"lat\": 37.7596,\n    \"lng\": -122.4269\n  },\n  \"package\": {\n    \"description\": \"Documents\",\n    \"weightKg\": 1.5,\n    \"lengthCm\": 30,\n    \"widthCm\": 20,\n    \"heightCm\": 10,\n    \"fragile\": false\n  },\n  \"priority\": \"STANDARD\",\n  \"paymentMethodId\": \"pm_mock\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('has orderId', () => pm.expect(b.orderId).to.match(/^SFORD/));",
                  "pm.test('16-char tracking code (no 0/O/1/I)', () => pm.expect(b.trackingCode).to.match(/^[A-HJ-NP-Z2-9]{16}$/));",
                  "const quoted = pm.collectionVariables.get('quotedCost');",
                  "if (quoted) { pm.test('charged price = recommended price', () => pm.expect(Number(b.estimatedCost)).to.eql(Number(quoted)));",
                  "  pm.test('ETA = recommended ETA', () => pm.expect(Number(b.estimatedTimeMinutes)).to.eql(Number(pm.collectionVariables.get('quotedMinutes')))); }",
                  "pm.collectionVariables.set('orderId', b.orderId);",
                  "pm.collectionVariables.set('trackingCode', b.trackingCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Order detail: final price = recommended price",
          "request": {
