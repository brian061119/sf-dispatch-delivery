          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns a token', () => pm.expect(b.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('adminToken', b.token);"
